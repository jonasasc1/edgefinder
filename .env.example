# Vorlage. Kopieren nach .env (chmod 600, Besitzer edgefinder) und echte Werte eintragen.
# Die .env wird nie eingecheckt.

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# CFTC Socrata App-Token (optional, erhöht nur das Rate-Limit)
CFTC_APP_TOKEN=

# Myfxbook-Login (Community Outlook, max. 100 Requests / 24 h)
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# Kontakt-E-Mail für den User-Agent bei SEC EDGAR (von der SEC verlangt)
CONTACT_EMAIL=

# Optional, Benutzerkonten: strikter JWT-Modus für Cloudflare Access. Nur wenn BEIDE Werte gesetzt sind,
# prüft die App die Signatur des Access-Tokens; sonst gilt der Header-Modus (siehe README „Konten“).
# Team-Domain: Zero Trust → Settings → Custom Pages (z. B. meinteam.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) Tag: Zero Trust → Access → Applications → edgefinder → Overview
CF_ACCESS_AUD=

# Optional: abweichender Pfad zur Konfiguration (Standard: ./config.yaml)
# EDGEFINDER_CONFIG=
