# Vorlage. Kopieren nach .env (chmod 600, Besitzer edgefinder) und echte Werte eintragen.
# Die .env wird nie eingecheckt.

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# CFTC Socrata App-Token (optional, erhöht nur das Rate-Limit)
CFTC_APP_TOKEN=

# Myfxbook-Login (Community Outlook, max. 100 Requests / 24 h)
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=

# Kontakt-E-Mail für den User-Agent bei SEC EDGAR (von der SEC verlangt)
CONTACT_EMAIL=

# Optional: abweichender Pfad zur Konfiguration (Standard: ./config.yaml)
# EDGEFINDER_CONFIG=
