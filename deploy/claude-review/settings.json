{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write(./output/**)",
      "Edit(./output/**)",
      "MultiEdit(./output/**)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat)",
      "Bash(cat *)",
      "Bash(grep)",
      "Bash(grep *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(head)",
      "Bash(head *)",
      "Bash(tail)",
      "Bash(tail *)",
      "Bash(diff)",
      "Bash(diff *)",
      "Bash(sort)",
      "Bash(sort *)",
      "Bash(uniq)",
      "Bash(uniq *)",
      "Bash(cut)",
      "Bash(cut *)",
      "Bash(basename)",
      "Bash(basename *)",
      "Bash(dirname)",
      "Bash(dirname *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(stat)",
      "Bash(stat *)",
      "Bash(file)",
      "Bash(file *)",
      "Bash(/opt/claude-review/venv/bin/python -m pytest *)",
      "Bash(/opt/claude-review/venv/bin/python -m ruff check *)",
      "Bash(/opt/claude-review/venv/bin/python -m json.tool *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent",
      "Skill",
      "NotebookEdit",
      "mcp__*",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(socat *)",
      "Bash(telnet *)",
      "Bash(ftp *)",
      "Bash(rsync *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(systemctl *)",
      "Bash(journalctl *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(dpkg *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(docker *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(ln *)",
      "Bash(tee *)",
      "Bash(dd *)",
      "Bash(env *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(perl *)",
      "Bash(ruby *)",
      "Bash(find *)",
      "Bash(xargs *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(curl)",
      "Bash(wget)",
      "Bash(ssh)",
      "Bash(scp)",
      "Bash(sftp)",
      "Bash(nc)",
      "Bash(ncat)",
      "Bash(netcat)",
      "Bash(socat)",
      "Bash(telnet)",
      "Bash(ftp)",
      "Bash(rsync)",
      "Bash(sudo)",
      "Bash(su)",
      "Bash(doas)",
      "Bash(systemctl)",
      "Bash(journalctl)",
      "Bash(apt)",
      "Bash(apt-get)",
      "Bash(dpkg)",
      "Bash(pip)",
      "Bash(pip3)",
      "Bash(uv)",
      "Bash(npm)",
      "Bash(npx)",
      "Bash(node)",
      "Bash(git)",
      "Bash(docker)",
      "Bash(kill)",
      "Bash(pkill)",
      "Bash(chmod)",
      "Bash(chown)",
      "Bash(rm)",
      "Bash(mv)",
      "Bash(cp)",
      "Bash(ln)",
      "Bash(tee)",
      "Bash(dd)",
      "Bash(env)",
      "Bash(bash)",
      "Bash(sh)",
      "Bash(python)",
      "Bash(python3)",
      "Bash(perl)",
      "Bash(ruby)",
      "Bash(find)",
      "Bash(xargs)",
      "Bash(awk)",
      "Bash(sed)",
      "Read(//var/lib/claude-review/.home/**)",
      "Read(//var/lib/claude-review/.claude/**)",
      "Read(//var/lib/claude-review/inbox/**)",
      "Read(//var/lib/claude-review/staging/**)",
      "Read(//var/lib/edgefinder/**)",
      "Read(//opt/edgefinder/**)",
      "Read(//etc/**)",
      "Read(//root/**)",
      "Read(//home/**)",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(~/**)",
      "Edit(//**)",
      "Write(//**)",
      "Write(~/**)",
      "Edit(~/.claude/**)"
    ],
    "denyInsteadOfPrompting": true,
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
    "DISABLE_COST_WARNINGS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I /opt/claude-review/hooks/audit.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I /opt/claude-review/hooks/audit.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I /opt/claude-review/hooks/audit.py",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "enableAllProjectMcpServers": false,
  "autoMemoryEnabled": false,
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 30
}
