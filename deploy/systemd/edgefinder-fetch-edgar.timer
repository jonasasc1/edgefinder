# ERZEUGT von `edgefinder gen-systemd` aus config.yaml – nicht von Hand ändern.
# Zeitpläne in config.yaml anpassen und die Dateien neu erzeugen.
[Unit]
Description=edgefinder: Quelle edgar holen

[Timer]
OnCalendar=*-*-* 05:30:00 Europe/Vienna
Persistent=true
RandomizedDelaySec=60
Unit=edgefinder-fetch@edgar.service

[Install]
WantedBy=timers.target
