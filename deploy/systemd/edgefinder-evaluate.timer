# ERZEUGT von `edgefinder gen-systemd` aus config.yaml – nicht von Hand ändern.
# Zeitpläne in config.yaml anpassen und die Dateien neu erzeugen.
[Unit]
Description=edgefinder: Live-Signale auswerten

[Timer]
OnCalendar=*-*-* 00:10:00 Europe/Vienna
Persistent=true
RandomizedDelaySec=60
Unit=edgefinder-evaluate.service

[Install]
WantedBy=timers.target
