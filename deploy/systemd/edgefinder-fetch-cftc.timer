# ERZEUGT von `edgefinder gen-systemd` aus config.yaml – nicht von Hand ändern.
# Zeitpläne in config.yaml anpassen und die Dateien neu erzeugen.
[Unit]
Description=edgefinder: Quelle cftc holen

[Timer]
OnCalendar=Fri *-*-* 22:15:00 Europe/Vienna
Persistent=true
RandomizedDelaySec=60
Unit=edgefinder-fetch@cftc.service

[Install]
WantedBy=timers.target
