# ERZEUGT von `edgefinder gen-systemd` aus config.yaml – nicht von Hand ändern.
# Zeitpläne in config.yaml anpassen und die Dateien neu erzeugen.
[Unit]
Description=edgefinder: Scores berechnen
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=edgefinder
Group=edgefinder
WorkingDirectory=/opt/edgefinder
ExecStart=/usr/bin/flock -w 7200 /var/lib/edgefinder/.jobs.lock /opt/edgefinder/.venv/bin/edgefinder score
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
MemoryMax=1G
TimeoutStartSec=3h
SyslogIdentifier=edgefinder
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/edgefinder
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0027
