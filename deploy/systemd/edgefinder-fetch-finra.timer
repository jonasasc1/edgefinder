# ERZEUGT von `edgefinder gen-systemd` aus config.yaml – nicht von Hand ändern.
# Zeitpläne in config.yaml anpassen und die Dateien neu erzeugen.
[Unit]
Description=edgefinder: Quelle finra holen

[Timer]
OnCalendar=Mon,Thu *-*-* 05:45:00 Europe/Vienna
Persistent=true
RandomizedDelaySec=60
Unit=edgefinder-fetch@finra.service

[Install]
WantedBy=timers.target
