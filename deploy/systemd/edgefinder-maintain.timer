# ERZEUGT von `edgefinder gen-systemd` aus config.yaml – nicht von Hand ändern.
# Zeitpläne in config.yaml anpassen und die Dateien neu erzeugen.
[Unit]
Description=edgefinder: Eichung neu erzeugen

[Timer]
OnCalendar=Sun *-*-* 04:30:00 Europe/Vienna
Persistent=true
RandomizedDelaySec=60
Unit=edgefinder-maintain.service

[Install]
WantedBy=timers.target
